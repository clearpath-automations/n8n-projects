        "categories": {
          "categories": [
            {
              "category": "=Billing & Subscription",
              "description": "All emails related to payments, invoices, refunds, failed transactions, subscription upgrades/downgrades, cancellations, pricing questions, or plan changes.  Includes:  “I was charged twice”  “Please cancel my subscription”  “My payment failed”  “How much is the Pro plan?”  Refund requests"
            },
            {
              "category": "=Technical Support",
              "description": "Any issue involving system errors, bugs, features not working, login problems, integrations failing, performance issues, or unexpected behavior.  Includes:  Platform errors  Broken features  Login/account access problems  “It’s not working”  API/integration failures"
            },
            {
              "category": "=Product & Usage Questions",
              "description": "General how-to questions, onboarding help, clarification about features, documentation guidance, or best practices.  Includes:  “How do I export data?”  “Where can I find…?”  “How does this feature work?”  Setup guidance"
            },
            {
              "category": "=Sales & Partnerships",
              "description": "Pre-sales questions, demo requests, enterprise inquiries, bulk pricing, affiliate requests, or partnership proposals.  Includes:  “Can I get a demo?”  Enterprise pricing  Agency partnerships  Reseller inquiries"
            },
            {
              "category": "Complaints & Security Concerns",
              "description": "Customer dissatisfaction, escalations, negative feedback, privacy issues, suspicious activity, or data/security-related concerns.  Includes:  “I’m very disappointed”  Data breach concerns  Unauthorized login alerts  GDPR/data deletion requests"
            }
          ]
        },
        "options": {
          "systemPromptTemplate": "=You are an email classification assistant.\n\nClassify the following customer email into one of these categories:\n\n1. Billing & Subscription\n2. Technical Support\n3. Product & Usage Questions\n4. Sales & Partnerships\n5. Complaints & Security Concerns\n\nRespond with only one category name exactly as written above.\n"
        }
